<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>TwentyMate</AssemblyName>
    <RootNamespace>TwentyMate</RootNamespace>
    <Version>2.2.0</Version>
    <Product>TwentyMate</Product>
    <Company>TwentyMate</Company>
    <Description>20-20-20 rule eye break reminders</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- NativeAOT: no .NET Desktop Runtime dependency, no reflection-based JSON/XAML loading. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>false</InvariantGlobalization>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>

    <!-- x:Bind-equivalent for Avalonia: bindings resolved at compile time instead of reflection. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- AVLN3001: BreakWindow/SettingsWindow/TrayMenuWindow take required constructor
         arguments and are always constructed directly in code, never through the runtime
         XAML type-loader this warning is about — safe to ignore, same as WFAC010 before it. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Languages\*.json" />
  </ItemGroup>

</Project>
