<Window x:Class="TwentyMate.Views.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TwentyMate.Controls"
        Title="TwentyMate"
        Width="316"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Border Margin="16"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource StrokeStrongBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="0,8">

            <!-- Статус: кольцо, оставшееся время и подпись -->
            <Grid Margin="16,8,16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="52" Height="52" VerticalAlignment="Center">
                    <controls:ProgressRingArc x:Name="Ring"
                                              Thickness="4"
                                              TrackBrush="{DynamicResource TrackBrush}"
                                              ArcBrush="{DynamicResource AccentBrush}" />
                    <TextBlock x:Name="RingGlyph"
                               Text="&#xE7B3;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </Grid>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TimeText"
                               Text="20:00"
                               Style="{StaticResource TitleText}" />
                    <TextBlock x:Name="StatusText"
                               Text="{DynamicResource Tray_Status_NextBreak}"
                               Style="{StaticResource CaptionText}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="8,0" />

            <!-- Действия -->
            <StackPanel Margin="8,8,8,0">
                <Button x:Name="BreakNowButton" Style="{StaticResource SubtleButton}"
                        HorizontalAlignment="Stretch" Height="36" Click="OnBreakNow">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" VerticalAlignment="Center" Width="24"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="BreakNowText" Text="{DynamicResource Tray_BreakNow_Default}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="PauseButton" Style="{StaticResource SubtleButton}"
                        HorizontalAlignment="Stretch" Height="36" Click="OnTogglePause">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PauseGlyph" Text="&#xE769;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" VerticalAlignment="Center" Width="24"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="PauseText" Text="{DynamicResource Action_Pause}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Быстрые интервалы паузы: четыре кнопки поровну на всю ширину меню -->
                <UniformGrid x:Name="PausePresets" Rows="1" Columns="4" Margin="0,2,0,4">
                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Tray_Preset_30Min}" MinHeight="28"
                            Padding="0" Margin="0,0,4,0" FontSize="12" Tag="30" Click="OnPausePreset" />
                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Tray_Preset_1Hour}" MinHeight="28"
                            Padding="0" Margin="0,0,4,0" FontSize="12" Tag="60" Click="OnPausePreset" />
                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Tray_Preset_2Hours}" MinHeight="28"
                            Padding="0" Margin="0,0,4,0" FontSize="12" Tag="120" Click="OnPausePreset" />
                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Tray_Preset_Tomorrow}" MinHeight="28"
                            Padding="0" FontSize="12" Tag="tomorrow" Click="OnPausePreset" />
                </UniformGrid>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="8,6" />

            <StackPanel Margin="8,0,8,4">
                <Button Style="{StaticResource SubtleButton}" HorizontalAlignment="Stretch"
                        Height="36" Click="OnSettings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" VerticalAlignment="Center" Width="24"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{DynamicResource Tray_Menu_Settings}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SubtleButton}" HorizontalAlignment="Stretch"
                        Height="36" Click="OnQuit">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" VerticalAlignment="Center" Width="24"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{DynamicResource Tray_Menu_Quit}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock x:Name="StatsText"
                       Style="{StaticResource CaptionText}"
                       Margin="20,4,20,10" />
        </StackPanel>
    </Border>
</Window>
