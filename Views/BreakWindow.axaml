<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:TwentyMate.Controls"
        x:Class="TwentyMate.Views.BreakWindow"
        Title="TwentyMate"
        WindowDecorations="None"
        CanResize="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Opacity="0">

    <Grid>
        <!-- Dimming backdrop: darker toward the edges, a touch lighter in the center -->
        <Grid.Background>
            <RadialGradientBrush GradientOrigin="0.5,0.45" Center="0.5,0.45" RadiusX="0.85" RadiusY="0.95">
                <GradientStop Color="#F2141A22" Offset="0" />
                <GradientStop Color="#FA0B0E13" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <!-- Soft accent glow behind the ring -->
        <Ellipse Width="620" Height="620"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Margin="0,-40,0,0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0" />
                    <GradientStop Color="#00000000" Offset="0.62" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.OpacityMask>
                <RadialGradientBrush>
                    <GradientStop Color="#38FFFFFF" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.OpacityMask>
        </Ellipse>

        <StackPanel x:Name="ContentRoot"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5"
                    RenderTransform="scale(0.94)">
            <StackPanel.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.32" Easing="CubicEaseOut" />
                </Transitions>
            </StackPanel.Transitions>

            <!-- Countdown ring -->
            <Grid Width="240" Height="240" HorizontalAlignment="Center">
                <controls:ProgressRingArc x:Name="Ring"
                                          Thickness="10"
                                          TrackBrush="#1FFFFFFF"
                                          ArcBrush="{DynamicResource AccentBrush}" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="CountdownText"
                               Text="20"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="72"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFFFF"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Break_SecondsLabel}"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="14"
                               Foreground="#8CFFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,-6,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{DynamicResource Break_Heading}"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="34"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,36,0,0" />

            <TextBlock Text="{DynamicResource Break_Instruction}"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="16"
                       Foreground="#A8FFFFFF"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       MaxWidth="460"
                       Margin="0,10,0,0" />

            <StackPanel x:Name="Actions"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,36,0,0">
                <Button x:Name="PostponeButton"
                        Content="{DynamicResource Break_Postpone}"
                        MinWidth="132"
                        Margin="0,0,12,0"
                        Background="#1AFFFFFF"
                        BorderBrush="#33FFFFFF"
                        Foreground="#FFFFFFFF"
                        Click="OnPostpone" />
                <Button x:Name="SkipButton"
                        Classes="accent"
                        Content="{DynamicResource Break_Skip}"
                        MinWidth="132"
                        Click="OnSkip" />
            </StackPanel>

            <TextBlock x:Name="HintText"
                       Text="{DynamicResource Break_Hint}"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="12"
                       Foreground="#66FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,24,0,0" />
        </StackPanel>
    </Grid>
</Window>
