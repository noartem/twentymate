<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:TwentyMate.Controls"
        x:Class="TwentyMate.Views.TrayMenuWindow"
        Title="TwentyMate"
        Width="316"
        SizeToContent="Height"
        WindowDecorations="None"
        CanResize="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Opacity="0">

    <Border Margin="16"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource StrokeStrongBrush}"
            BorderThickness="1"
            CornerRadius="8"
            BoxShadow="0 8 28 0 #75000000">

        <StackPanel Margin="0,8">

            <!-- Status: ring, remaining time, and caption -->
            <Grid Margin="16,8,16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="52" Height="52" VerticalAlignment="Center">
                    <controls:ProgressRingArc x:Name="Ring"
                                              Thickness="4"
                                              TrackBrush="{DynamicResource TrackBrush}"
                                              ArcBrush="{DynamicResource AccentBrush}" />
                    <TextBlock x:Name="RingGlyph"
                               Text="&#xE7B3;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </Grid>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TimeText"
                               Text="20:00"
                               Classes="title-text" />
                    <TextBlock x:Name="StatusText"
                               Text="{DynamicResource Tray_Status_NextBreak}"
                               Classes="caption-text"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <Border Classes="row-divider" Margin="8,0" />

            <!-- Actions -->
            <StackPanel Margin="8,8,8,0">
                <Button x:Name="BreakNowButton" Classes="subtle" Click="OnBreakNow">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" VerticalAlignment="Center" Width="24"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="BreakNowText" Text="{DynamicResource Tray_BreakNow_Default}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="PauseButton" Classes="subtle" Click="OnTogglePause">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PauseGlyph" Text="&#xE769;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" VerticalAlignment="Center" Width="24"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="PauseText" Text="{DynamicResource Action_Pause}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Quick pause presets: four buttons splitting the menu's width evenly -->
                <UniformGrid x:Name="PausePresets" Rows="1" Columns="4" Margin="-2,2,-2,4">
                    <Button Classes="preset" Content="{DynamicResource Tray_Preset_30Min}" Tag="30" Click="OnPausePreset" />
                    <Button Classes="preset" Content="{DynamicResource Tray_Preset_1Hour}" Tag="60" Click="OnPausePreset" />
                    <Button Classes="preset" Content="{DynamicResource Tray_Preset_2Hours}" Tag="120" Click="OnPausePreset" />
                    <Button Classes="preset" Content="{DynamicResource Tray_Preset_Tomorrow}" Tag="tomorrow" Click="OnPausePreset" />
                </UniformGrid>
            </StackPanel>

            <Border Classes="row-divider" Margin="8,6" />

            <StackPanel Margin="8,0,8,4">
                <Button Classes="subtle" Click="OnSettings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" VerticalAlignment="Center" Width="24"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{DynamicResource Tray_Menu_Settings}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Classes="subtle" Click="OnQuit">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" VerticalAlignment="Center" Width="24"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{DynamicResource Tray_Menu_Quit}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock x:Name="StatsText"
                       Classes="caption-text"
                       Margin="20,4,20,10" />
        </StackPanel>
    </Border>
</Window>
