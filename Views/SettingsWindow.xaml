<Window x:Class="TwentyMate.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TwentyMate.Controls"
        Title="TwentyMate"
        Width="640" Height="720"
        MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <!-- Строка настройки: слева подпись и пояснение, справа контрол -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,10" />
        </Style>
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource StrokeBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════ Шапка со статусом ═══════════ -->
        <Border Grid.Row="0" Margin="20,16,20,8" Style="{StaticResource Card}" Padding="18,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="64" Height="64" VerticalAlignment="Center">
                    <controls:ProgressRingArc x:Name="StatusRing"
                                              Thickness="5"
                                              TrackBrush="{DynamicResource TrackBrush}"
                                              ArcBrush="{DynamicResource AccentBrush}" />
                    <TextBlock Text="&#xE7B3;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="22"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}" />
                </Grid>

                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTitle" Text="{DynamicResource Settings_Status_NextBreak}"
                               Style="{StaticResource TitleText}"
                               FontSize="19"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="StatusSubtitle" Text="{DynamicResource Settings_Status_NextBreakSubtitle}"
                               Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PauseButton" Style="{StaticResource SecondaryButton}"
                            Content="{DynamicResource Action_Pause}" MinWidth="96" Margin="0,0,8,0" Click="OnTogglePause" />
                    <Button Style="{StaticResource AccentButton}"
                            Content="{DynamicResource Settings_HeaderCard_BreakNowButton}" MinWidth="96" Click="OnBreakNow" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ Настройки ═══════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,0,14,20">
            <StackPanel Margin="0,8,6,0">

                <!-- ───────── Расписание ───────── -->
                <TextBlock Text="{DynamicResource Settings_Section_Schedule}" Style="{StaticResource SectionText}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings_Interval_Label}" Style="{StaticResource BodyText}" />
                                <TextBlock Text="{DynamicResource Settings_Interval_Desc}"
                                           Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="IntervalSlider" Style="{StaticResource FluentSlider}"
                                        Minimum="5" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True"
                                        ValueChanged="OnSettingChanged" />
                                <TextBlock x:Name="IntervalValueText" Grid.Column="1" Style="{StaticResource BodyText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings_BreakDuration_Label}" Style="{StaticResource BodyText}" />
                                <TextBlock Text="{DynamicResource Settings_BreakDuration_Desc}"
                                           Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="BreakSlider" Style="{StaticResource FluentSlider}"
                                        Minimum="5" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True"
                                        ValueChanged="OnSettingChanged" />
                                <TextBlock x:Name="BreakValueText" Grid.Column="1" Style="{StaticResource BodyText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings_Postpone_Label}" Style="{StaticResource BodyText}" />
                                <TextBlock Text="{DynamicResource Settings_Postpone_Desc}"
                                           Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="PostponeSlider" Style="{StaticResource FluentSlider}"
                                        Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                                        ValueChanged="OnSettingChanged" />
                                <TextBlock x:Name="PostponeValueText" Grid.Column="1" Style="{StaticResource BodyText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ───────── Уведомления ───────── -->
                <TextBlock Text="{DynamicResource Settings_Section_Notifications}" Style="{StaticResource SectionText}" Margin="2,20,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings_NotifyStyle_Label}" Style="{StaticResource BodyText}" />
                                <TextBlock Text="{DynamicResource Settings_NotifyStyle_Desc}"
                                           Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ComboBox x:Name="StyleCombo" Grid.Column="1" Style="{StaticResource FluentComboBox}"
                                      VerticalAlignment="Center" SelectionChanged="OnSettingChanged">
                                <ComboBoxItem Content="{DynamicResource Settings_NotifyStyle_TrayOnly}" />
                                <ComboBoxItem Content="{DynamicResource Settings_NotifyStyle_Toast}" />
                                <ComboBoxItem Content="{DynamicResource Settings_NotifyStyle_Overlay}" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings_SoundStart}" Style="{StaticResource BodyText}" />
                            </StackPanel>
                            <ToggleButton x:Name="SoundStartToggle" Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}" Click="OnSettingChanged" />
                        </Grid>

                        <Border Style="{StaticResource RowDivider}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings_SoundEnd}" Style="{StaticResource BodyText}"
                                       VerticalAlignment="Center" />
                            <ToggleButton x:Name="SoundEndToggle" Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}" Click="OnSettingChanged" />
                        </Grid>

                        <Border Style="{StaticResource RowDivider}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings_AllowSkip_Label}" Style="{StaticResource BodyText}" />
                                <TextBlock Text="{DynamicResource Settings_AllowSkip_Desc}"
                                           Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="AllowSkipToggle" Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}" Click="OnSettingChanged" />
                        </Grid>

                        <Border Style="{StaticResource RowDivider}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings_DimAllScreens}" Style="{StaticResource BodyText}"
                                       VerticalAlignment="Center" />
                            <ToggleButton x:Name="DimAllToggle" Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}" Click="OnSettingChanged" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ───────── Рабочие часы ───────── -->
                <TextBlock Text="{DynamicResource Settings_Section_WorkingHours}" Style="{StaticResource SectionText}" Margin="2,20,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings_WorkHoursOnly_Label}" Style="{StaticResource BodyText}" />
                                <TextBlock Text="{DynamicResource Settings_WorkHoursOnly_Desc}"
                                           Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="WorkHoursToggle" Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}" Click="OnSettingChanged" />
                        </Grid>

                        <StackPanel x:Name="WorkHoursPanel">
                            <Border Style="{StaticResource RowDivider}" />

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Settings_WorkHoursRange_Label}" Style="{StaticResource BodyText}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="WorkStartBox" Style="{StaticResource FluentTextBox}"
                                             Width="76" TextAlignment="Center"
                                             MaxLength="5" LostFocus="OnTimeChanged" />
                                    <TextBlock Text="—" VerticalAlignment="Center" Margin="8,0"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBox x:Name="WorkEndBox" Style="{StaticResource FluentTextBox}"
                                             Width="76" TextAlignment="Center"
                                             MaxLength="5" LostFocus="OnTimeChanged" />
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource RowDivider}" />

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Settings_WorkDays_Label}" Style="{StaticResource BodyText}"
                                           VerticalAlignment="Center" />
                                <StackPanel x:Name="DaysPanel" Grid.Column="1" Orientation="Horizontal" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ───────── Автопауза ───────── -->
                <TextBlock Text="{DynamicResource Settings_Section_AutoPause}" Style="{StaticResource SectionText}" Margin="2,20,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings_AutoPause_Label}" Style="{StaticResource BodyText}" />
                                <TextBlock Text="{DynamicResource Settings_AutoPause_Desc}"
                                           Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="AutoPauseToggle" Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}" Click="OnSettingChanged" />
                        </Grid>

                        <StackPanel x:Name="AutoPausePanel">
                            <Border Style="{StaticResource RowDivider}" />

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="240" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Settings_IdleThreshold_Label}" Style="{StaticResource BodyText}" />
                                    <TextBlock Text="{DynamicResource Settings_IdleThreshold_Desc}"
                                               Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="IdleThresholdSlider" Style="{StaticResource FluentSlider}"
                                            Minimum="1" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True"
                                            ValueChanged="OnSettingChanged" />
                                    <TextBlock x:Name="IdleThresholdValueText" Grid.Column="1" Style="{StaticResource BodyText}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ───────── Общее ───────── -->
                <TextBlock Text="{DynamicResource Settings_Section_General}" Style="{StaticResource SectionText}" Margin="2,20,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings_Autostart_Label}" Style="{StaticResource BodyText}" />
                                <TextBlock Text="{DynamicResource Settings_Autostart_Desc}"
                                           Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="AutostartToggle" Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}" Click="OnSettingChanged" />
                        </Grid>

                        <Border Style="{StaticResource RowDivider}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings_Theme_Label}" Style="{StaticResource BodyText}"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" Style="{StaticResource FluentComboBox}"
                                      VerticalAlignment="Center" SelectionChanged="OnSettingChanged">
                                <ComboBoxItem Content="{DynamicResource Settings_Theme_System}" />
                                <ComboBoxItem Content="{DynamicResource Settings_Theme_Light}" />
                                <ComboBoxItem Content="{DynamicResource Settings_Theme_Dark}" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings_Language_Label}" Style="{StaticResource BodyText}"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="LanguageCombo" Grid.Column="1" Style="{StaticResource FluentComboBox}"
                                      VerticalAlignment="Center" SelectionChanged="OnSettingChanged">
                                <ComboBoxItem Content="Системный / System" />
                                <ComboBoxItem Content="English" />
                                <ComboBoxItem Content="Русский" />
                                <ComboBoxItem Content="Español" />
                                <ComboBoxItem Content="Deutsch" />
                                <ComboBoxItem Content="Français" />
                                <ComboBoxItem Content="Português (Brasil)" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ───────── Подвал ───────── -->
                <Grid Margin="2,18,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="StatsText" Style="{StaticResource CaptionText}" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                            Content="{DynamicResource Settings_Reset_Button}" MinWidth="96" Click="OnReset" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
