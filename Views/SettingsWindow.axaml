<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:TwentyMate.Controls"
        x:Class="TwentyMate.Views.SettingsWindow"
        Title="TwentyMate"
        Width="640" Height="720"
        MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowDecorations="BorderOnly"
        CanMaximize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: same background as the body, so there's no visible seam.
             WindowDecorations="BorderOnly" keeps the native frame (resize, shadow, snap) but drops
             the title bar the theme would otherwise draw on top of this one, so the caption buttons
             are ours too. The ElementRole attached properties hand drag, the system menu, and the
             button hit-testing back to the OS. Maximize/full screen are deliberately absent. -->
        <Border Grid.Row="0"
                Background="{DynamicResource WindowBackgroundBrush}"
                WindowDecorationProperties.ElementRole="TitleBar">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7B3;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="TwentyMate" Classes="caption-text" Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Classes="caption"
                            Content="&#xE921;"
                            WindowDecorationProperties.ElementRole="MinimizeButton"
                            Click="OnMinimize" />
                    <Button Classes="caption close"
                            Content="&#xE8BB;"
                            WindowDecorationProperties.ElementRole="CloseButton"
                            Click="OnCloseWindow" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ Settings ═══════════ -->
        <!-- Everything below the title bar scrolls together, and the gutter lives on the scrolled
             content rather than on the ScrollViewer: as padding it would sit outside the viewport,
             leaving a dead strip at the bottom the content never reaches. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,20">

                <!-- ───────── Status header ───────── -->
                <Border Classes="card" Padding="18,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="64" Height="64" VerticalAlignment="Center">
                            <controls:ProgressRingArc x:Name="StatusRing"
                                                      Thickness="5"
                                                      TrackBrush="{DynamicResource TrackBrush}"
                                                      ArcBrush="{DynamicResource AccentBrush}" />
                            <TextBlock Text="&#xE7B3;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="22"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusTitle" Text="{DynamicResource Settings_Status_NextBreak}"
                                       Classes="title-text"
                                       FontSize="19"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="StatusSubtitle" Text="{DynamicResource Settings_Status_NextBreakSubtitle}"
                                       Classes="caption-text" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PauseButton"
                                    Content="{DynamicResource Action_Pause}" MinWidth="96" Margin="0,0,8,0" Click="OnTogglePause" />
                            <Button Classes="accent"
                                    Content="{DynamicResource Settings_HeaderCard_BreakNowButton}" MinWidth="96" Click="OnBreakNow" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ───────── Schedule ───────── -->
                <TextBlock Text="{DynamicResource Settings_Section_Schedule}" Classes="section-text" Margin="2,20,0,8" />
                <Border Classes="card">
                    <StackPanel>
                        <Grid Classes="settings-row">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings_Interval_Label}" Classes="body-text" />
                                <TextBlock Text="{DynamicResource Settings_Interval_Desc}"
                                           Classes="caption-text" Margin="0,2,0,0" />
                            </StackPanel>
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="IntervalSlider"
                                        Minimum="5" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True"
                                        ValueChanged="OnSliderChanged" />
                                <TextBlock x:Name="IntervalValueText" Grid.Column="1" Classes="body-text"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </Grid>

                        <Border Classes="row-divider" />

                        <Grid Classes="settings-row">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings_BreakDuration_Label}" Classes="body-text" />
                                <TextBlock Text="{DynamicResource Settings_BreakDuration_Desc}"
                                           Classes="caption-text" Margin="0,2,0,0" />
                            </StackPanel>
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="BreakSlider"
                                        Minimum="5" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True"
                                        ValueChanged="OnSliderChanged" />
                                <TextBlock x:Name="BreakValueText" Grid.Column="1" Classes="body-text"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </Grid>

                        <Border Classes="row-divider" />

                        <Grid Classes="settings-row">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings_Postpone_Label}" Classes="body-text" />
                                <TextBlock Text="{DynamicResource Settings_Postpone_Desc}"
                                           Classes="caption-text" Margin="0,2,0,0" />
                            </StackPanel>
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="PostponeSlider"
                                        Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                                        ValueChanged="OnSliderChanged" />
                                <TextBlock x:Name="PostponeValueText" Grid.Column="1" Classes="body-text"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ───────── Notifications ───────── -->
                <TextBlock Text="{DynamicResource Settings_Section_Notifications}" Classes="section-text" Margin="2,20,0,8" />
                <Border Classes="card">
                    <StackPanel>
                        <Grid Classes="settings-row">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings_NotifyStyle_Label}" Classes="body-text" />
                                <TextBlock Text="{DynamicResource Settings_NotifyStyle_Desc}"
                                           Classes="caption-text" Margin="0,2,0,0" />
                            </StackPanel>
                            <ComboBox x:Name="StyleCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center" SelectionChanged="OnSelectionChanged">
                                <ComboBoxItem Content="{DynamicResource Settings_NotifyStyle_TrayOnly}" />
                                <ComboBoxItem Content="{DynamicResource Settings_NotifyStyle_Toast}" />
                                <ComboBoxItem Content="{DynamicResource Settings_NotifyStyle_Overlay}" />
                            </ComboBox>
                        </Grid>

                        <Border Classes="row-divider" />

                        <Grid Classes="settings-row">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings_SoundStart}" Classes="body-text" />
                            </StackPanel>
                            <ToggleSwitch x:Name="SoundStartToggle" Grid.Column="1" IsCheckedChanged="OnSettingChanged" />
                        </Grid>

                        <Border Classes="row-divider" />

                        <Grid Classes="settings-row">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings_SoundEnd}" Classes="body-text"
                                       VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="SoundEndToggle" Grid.Column="1" IsCheckedChanged="OnSettingChanged" />
                        </Grid>

                        <Border Classes="row-divider" />

                        <Grid Classes="settings-row">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings_AllowSkip_Label}" Classes="body-text" />
                                <TextBlock Text="{DynamicResource Settings_AllowSkip_Desc}"
                                           Classes="caption-text" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AllowSkipToggle" Grid.Column="1" IsCheckedChanged="OnSettingChanged" />
                        </Grid>

                        <Border Classes="row-divider" />

                        <Grid Classes="settings-row">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings_DimAllScreens}" Classes="body-text"
                                       VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="DimAllToggle" Grid.Column="1" IsCheckedChanged="OnSettingChanged" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ───────── Working hours ───────── -->
                <TextBlock Text="{DynamicResource Settings_Section_WorkingHours}" Classes="section-text" Margin="2,20,0,8" />
                <Border Classes="card">
                    <StackPanel>
                        <Grid Classes="settings-row">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings_WorkHoursOnly_Label}" Classes="body-text" />
                                <TextBlock Text="{DynamicResource Settings_WorkHoursOnly_Desc}"
                                           Classes="caption-text" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleSwitch x:Name="WorkHoursToggle" Grid.Column="1" IsCheckedChanged="OnSettingChanged" />
                        </Grid>

                        <StackPanel x:Name="WorkHoursPanel">
                            <Border Classes="row-divider" />

                            <Grid Classes="settings-row">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Settings_WorkHoursRange_Label}" Classes="body-text"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="WorkStartBox"
                                             Width="76" TextAlignment="Center"
                                             MaxLength="5" LostFocus="OnTimeChanged" />
                                    <TextBlock Text="—" VerticalAlignment="Center" Margin="8,0"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBox x:Name="WorkEndBox"
                                             Width="76" TextAlignment="Center"
                                             MaxLength="5" LostFocus="OnTimeChanged" />
                                </StackPanel>
                            </Grid>

                            <Border Classes="row-divider" />

                            <Grid Classes="settings-row">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Settings_WorkDays_Label}" Classes="body-text"
                                           VerticalAlignment="Center" />
                                <StackPanel x:Name="DaysPanel" Grid.Column="1" Orientation="Horizontal" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ───────── Auto-pause ───────── -->
                <TextBlock Text="{DynamicResource Settings_Section_AutoPause}" Classes="section-text" Margin="2,20,0,8" />
                <Border Classes="card">
                    <StackPanel>
                        <Grid Classes="settings-row">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings_AutoPause_Label}" Classes="body-text" />
                                <TextBlock Text="{DynamicResource Settings_AutoPause_Desc}"
                                           Classes="caption-text" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoPauseToggle" Grid.Column="1" IsCheckedChanged="OnSettingChanged" />
                        </Grid>

                        <StackPanel x:Name="AutoPausePanel">
                            <Border Classes="row-divider" />

                            <Grid Classes="settings-row">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="240" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Settings_IdleThreshold_Label}" Classes="body-text" />
                                    <TextBlock Text="{DynamicResource Settings_IdleThreshold_Desc}"
                                               Classes="caption-text" Margin="0,2,0,0" />
                                </StackPanel>
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="IdleThresholdSlider"
                                            Minimum="1" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True"
                                            ValueChanged="OnSliderChanged" />
                                    <TextBlock x:Name="IdleThresholdValueText" Grid.Column="1" Classes="body-text"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ───────── General ───────── -->
                <TextBlock Text="{DynamicResource Settings_Section_General}" Classes="section-text" Margin="2,20,0,8" />
                <Border Classes="card">
                    <StackPanel>
                        <Grid Classes="settings-row">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings_Autostart_Label}" Classes="body-text" />
                                <TextBlock Text="{DynamicResource Settings_Autostart_Desc}"
                                           Classes="caption-text" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AutostartToggle" Grid.Column="1" IsCheckedChanged="OnSettingChanged" />
                        </Grid>

                        <Border Classes="row-divider" />

                        <Grid Classes="settings-row">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings_Theme_Label}" Classes="body-text"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center" SelectionChanged="OnSelectionChanged">
                                <ComboBoxItem Content="{DynamicResource Settings_Theme_System}" />
                                <ComboBoxItem Content="{DynamicResource Settings_Theme_Light}" />
                                <ComboBoxItem Content="{DynamicResource Settings_Theme_Dark}" />
                            </ComboBox>
                        </Grid>

                        <Border Classes="row-divider" />

                        <Grid Classes="settings-row">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings_Language_Label}" Classes="body-text"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="LanguageCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center" SelectionChanged="OnSelectionChanged">
                                <ComboBoxItem Content="Системный / System" />
                                <ComboBoxItem Content="English" />
                                <ComboBoxItem Content="Русский" />
                                <ComboBoxItem Content="Español" />
                                <ComboBoxItem Content="Deutsch" />
                                <ComboBoxItem Content="Français" />
                                <ComboBoxItem Content="Português (Brasil)" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ───────── Footer ───────── -->
                <Grid Margin="2,18,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="StatsText" Classes="caption-text" />
                        <TextBlock x:Name="VersionText" Classes="caption-text" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{DynamicResource Settings_Reset_Button}" MinWidth="96" Click="OnReset" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
